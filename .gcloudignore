# What `gcloud run deploy --source .` uploads to Cloud Build (it ignores .dockerignore).
# Keep in step with .dockerignore. Never upload secrets.
.gcloudignore
.git/
.gitignore
.env
.env.*
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.claude/
.continue/
.agents/
.vscode/
.idea/
.playwright-cli/
*.log
tests/
docs/
postman/
reference/
refer/
test-documents/
output/
runtime-db/
downloaded document/
storage/cache/
/documents/
*.md
!IDEA.MD
node_modules/
dist/
build/
